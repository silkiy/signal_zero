{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signal-zero:puzzle:sz-puzzle-1",
  "title": "SIGNAL ZERO gameplay puzzle sz-puzzle-1",
  "$comment": "Structural interchange schema. The authoritative bounded raw decoder additionally rejects duplicate JSON keys, noninteger lexical forms such as 1.0/1e0/-0, malformed UTF-8, BOM, input above 65536 bytes and nesting above 16. PuzzleSpec also checks cross-object uniqueness/references, source=target counts, node kind counts, directed endpoint pairs and routing degrees/ports. Schema validity is not solvability. Presentation metadata and generator provenance belong outside this object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "engine_version", "rules_version", "tick_limit", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "sz-puzzle-1"},
    "engine_version": {"const": "sz-engine-1"},
    "rules_version": {"const": "sz-rules-1"},
    "tick_limit": {"type": "integer", "minimum": 1, "maximum": 64},
    "nodes": {
      "type": "array", "minItems": 2, "maxItems": 64,
      "items": {"oneOf": [{"$ref": "#/$defs/plainNode"}, {"$ref": "#/$defs/switchNode"}]}
    },
    "edges": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]{0,31}(?![\\s\\S])"
    },
    "plainNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["source", "relay", "target"]}
      }
    },
    "switchNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "initial_state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"const": "switch"},
        "initial_state": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "port"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "port": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    }
  }
}
