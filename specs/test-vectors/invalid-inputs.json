  "rejection_cases": [
    {
      "id": "duplicate_node",
      "expected_error": "DUPLICATE_ID",
      "construction": "Repeat node id a."
    },
    {
      "id": "foreign_endpoint",
      "expected_error": "UNKNOWN_REFERENCE",
      "construction": "Edge references missing node."
    },
    {
      "id": "unknown_gameplay_field",
      "expected_error": "UNKNOWN_FIELD",
      "construction": "Add executable or URL field to gameplay object."
    },
    {
      "id": "duplicate_json_key",
      "expected_error": "DUPLICATE_FIELD",
      "construction": "Raw JSON contains the same key twice."
    },
    {
      "id": "unknown_version",
      "expected_error": "UNSUPPORTED_VERSION",
      "construction": "sz-rules-999 must not use latest handler."
    },
    {
      "id": "fraction_tick",
      "expected_error": "INVALID_INTEGER",
      "construction": "tick_limit token 1.0."
    },
    {
      "id": "exponent_tick",
      "expected_error": "INVALID_INTEGER",
      "construction": "tick_limit token 1e1."
    },
    {
      "id": "negative_zero",
      "expected_error": "INVALID_INTEGER",
      "construction": "Raw tick token -0."
    },
    {
      "id": "bool_tick",
      "expected_error": "INVALID_INTEGER",
      "construction": "true is not integer 1."
    },
    {
      "id": "negative_tick",
      "expected_error": "INVALID_INTEGER",
      "construction": "Negative integer token."
    },
    {
      "id": "duplicate_shift",
      "expected_error": "NON_CANONICAL_ACTIONS",
      "construction": "shift_ticks [2,2]."
    },
    {
      "id": "unsorted_shift",
      "expected_error": "NON_CANONICAL_ACTIONS",
      "construction": "shift_ticks [2,1]."
    },
    {
      "id": "tick_zero",
      "expected_error": "INVALID_TICK",
      "construction": "shift_ticks [0]."
    },
    {
      "id": "tick_over_limit",
      "expected_error": "INVALID_TICK",
      "construction": "shift_ticks [65], tick_limit64, even if earlier completion."
    },
    {
      "id": "source_target_count",
      "expected_error": "INVALID_GRAPH",
      "construction": "Source and target counts differ."
    },
    {
      "id": "duplicate_port",
      "expected_error": "INVALID_GRAPH",
      "construction": "Switch uses port0 twice or lacks port1."
    },
    {
      "id": "compression_bomb",
      "expected_error": "DECOMPRESSED_LIMIT",
      "construction": "Streaming output exceeds decoded byte budget; stop before JSON parse."
    },
    {
      "id": "deep_json",
      "expected_error": "DEPTH_LIMIT",
      "construction": "Nested input exceeds16."
    },
    {
      "id": "truncated_payload",
      "expected_error": "MALFORMED_INPUT",
      "construction": "Incomplete JSON/compressed frame."
    },
    {
      "id": "backup_unknown_secret",
      "expected_error": "UNKNOWN_FIELD",
      "construction": "Unknown wallet_secret/private_key field rejected by allowlist."
    },
    {
      "id": "unicode_id",
      "expected_error": "INVALID_ID",
      "construction": "Gameplay id contains non-ASCII code point."
    },
    {
      "id": "checksum_wrong",
      "expected_error": "CHECKSUM_MISMATCH",
      "construction": "Imported file checksum does not match content."
    }
  ],
  "non_invalid_results": [
    {
      "case": "legal_cycle",
      "schema": "VALID",
      "simulation": "TICK_LIMIT unless valid SHIFT exits",
      "solver": "UNKNOWN until proof or bounded search completes"
    },
    {
      "case": "solver_budget",
      "schema": "VALID",
      "solver": "BUDGET_EXHAUSTED",
      "not": "UNSATISFIABLE_OR_OPTIMAL"
    },
    {
      "case": "one_found_solution_no_proof",
      "schema": "VALID",
      "solver": "SOLVED_UNPROVEN",
      "not": "OPTIMAL"
    }
  ]
